{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "cleanUrls": true,
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[daily-data\\]'"
}
